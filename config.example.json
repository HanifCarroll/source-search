{
  "enabledSources": [],
  "maintenanceEnabled": false,
  "libraryEnabled": false,
  "timeZone": "UTC",
  "sources": {
    "notes": {
      "adapter": "markdown",
      "root": "/absolute/path/to/notes"
    },
    "tasks": {
      "adapter": "tasks",
      "connector": {
        "type": "json",
        "paths": ["/absolute/path/to/tasks.json"]
      }
    },
    "work-mail": {
      "adapter": "gmail",
      "account": "work",
      "email": "work@example.com"
    },
    "other-mail": {
      "adapter": "imap",
      "account": "other",
      "email": "user@example.com",
      "username": "user@example.com",
      "host": "imap.example.com",
      "port": 993,
      "auth": {
        "type": "password",
        "password": {
          "file": "/absolute/private/path/app-password"
        }
      }
    }
  }
}
